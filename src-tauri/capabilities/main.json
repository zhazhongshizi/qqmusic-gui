{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Expose renderer-safe state, authentication, playback, and queue commands to the local main window.",
  "windows": ["main"],
  "platforms": ["windows"],
  "permissions": [
    "allow-logging-status",
    "allow-logging-set-enabled",
    "allow-logging-frontend-error",
    "allow-remote-status",
    "allow-remote-set-enabled",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-is-minimized",
    "core:window:allow-is-visible",
    "core:window:allow-outer-position",
    "core:window:allow-outer-size",
    "core:window:allow-set-min-size",
    "core:window:allow-set-size",
    "core:window:allow-set-position",
    "core:window:allow-center",
    "core:window:allow-unmaximize",
    "core:window:allow-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "allow-app-snapshot",
    "allow-auth-status",
    "allow-auth-recover",
    "allow-auth-qr-start",
    "allow-auth-qr-poll",
    "allow-auth-qr-cancel",
    "allow-auth-logout",
    "allow-cover-get",
    "allow-player-snapshot",
    "allow-playback-history",
    "allow-personal-library",
    "allow-player-play",
    "allow-player-pause",
    "allow-player-stop",
    "allow-player-seek",
    "allow-player-set-volume",
    "allow-player-set-muted",
    "allow-lyrics-get",
    "allow-smtc-dynamic-lyrics-set-enabled",
    "allow-catalog-search-songs",
    "allow-catalog-discover-new-songs",
    "allow-catalog-playlist-songs",
    "allow-catalog-artist-detail",
    "allow-catalog-song-artists",
    "allow-catalog-artist-songs",
    "allow-catalog-search-entities",
    "allow-catalog-album-detail",
    "allow-catalog-album-songs",
    "allow-catalog-artist-albums",
    "allow-library-playlists",
    "allow-library-liked-songs",
    "allow-library-create-playlist",
    "allow-library-delete-playlist",
    "allow-library-add-songs",
    "allow-library-remove-songs",
    "allow-library-set-liked",
    "allow-library-set-favorite-playlist",
    "allow-local-music-list",
    "allow-local-music-catalog",
    "allow-local-music-import",
    "allow-local-music-delete",
    "allow-organizer-preview",
    "allow-organizer-execute",
    "allow-queue-snapshot",
    "allow-queue-replace",
    "allow-queue-enqueue",
    "allow-queue-enqueue-many",
    "allow-queue-enqueue-next",
    "allow-playback-set-mv-lyric-offset",
    "allow-settings-set-mv-fallback-enabled",
    "allow-queue-remove",
    "allow-queue-move",
    "allow-queue-play",
    "allow-settings-snapshot",
    "allow-updates-control",
    "allow-settings-set-preferred-quality",
    "allow-settings-set-live-spectrum-enabled",
    "allow-spectrum-set-stage-active",
    "allow-playback-change-quality",
    "allow-playback-session-snapshot",
    "allow-playback-set-mode",
    "allow-smart-shuffle-status",
    "allow-smart-shuffle-set-enabled",
    "allow-queue-preview-next",
    "allow-queue-next",
    "allow-queue-previous"
  ]
}
