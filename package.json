{
  "name": "qqmusic-gui",
  "version": "1.1.0",
  "description": "A local-first Windows desktop client for QQ Music.",
  "license": "GPL-3.0-or-later",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.16.0",
  "scripts": {
    "dev": "pnpm build:rhine && vite",
    "build": "pnpm build:rhine && tsc -b && vite build && vite build --config vite.remote.config.ts",
    "build:remote": "vite build --config vite.remote.config.ts",
    "build:e2e": "pnpm build:rhine && tsc -b && vite build --mode e2e",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "pnpm build:rhine && tsc -b --pretty false",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json --pretty false",
    "test": "pnpm build:rhine && vitest",
    "test:run": "pnpm build:rhine && vitest run",
    "test:e2e": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-desktop-e2e.ps1",
    "test:e2e:catalog-live": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-live-catalog-e2e.ps1",
    "test:e2e:playlist-playback-live": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-live-playlist-playback-e2e.ps1",
    "wdio": "wdio",
    "check": "pnpm typecheck && pnpm test:run",
    "build:rhine": "tsc -p vendor/rhine/tsconfig.json"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "0.183.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "26.2.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "0.183.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@wdio/cli": "9.30.1",
    "@wdio/globals": "9.29.1",
    "@wdio/local-runner": "9.30.1",
    "@wdio/mocha-framework": "9.30.1",
    "@wdio/native-types": "2.5.0",
    "@wdio/spec-reporter": "9.30.1",
    "@wdio/tauri-plugin": "1.3.0",
    "@wdio/tauri-service": "1.3.0",
    "@wdio/types": "9.30.1",
    "expect-webdriverio": "5.7.0",
    "jsdom": "^28.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.5",
    "vitest": "^4.0.18",
    "webdriverio": "9.30.1"
  }
}
